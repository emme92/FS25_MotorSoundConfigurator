    <!-- the vehicle's own engine a second time, shifted (clone of its main engine sample).
         Two copies with close pitches beat (audible pulsing at the difference of their firing frequencies, e.g. 0.9 =
         a 9:10 pattern that repeats at a tenth of the firing frequency, a few Hz). Small whole-number ratios repeat
         fast enough to be heard as one sound: octave 1:2 (pitchFactor 0.5), fifth 2:3 (0.667). Hearing test
         2026-10-02: octave and fifth kept, "Deeper" (0.9) and "Shifted" (rpm 1.15) removed (beating). -->
    <layer name="ownEngineOctave" group="ownEngine" source="own" category="motor" pitchFactor="0.5" volumeFactor="1.8"/>
    <layer name="ownEngineFifth" group="ownEngine" source="own" category="motor" pitchFactor="0.6667" volumeFactor="1.8"/>
    <layer name="ownEngineLoad" group="ownEngine" source="own" category="motor" volumeFactor="0.8">
        <motor>
            <volume>
                <modifier type="MOTOR_LOAD" value="0.3" modifiedValue="0"/>
                <modifier type="MOTOR_LOAD" value="1.0" modifiedValue="1"/>
            </volume>
        </motor>
    </layer>

